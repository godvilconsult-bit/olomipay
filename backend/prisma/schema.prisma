// JIKO CONNECT — LPG cooking-gas logistics marketplace (Tanzania)
// Three-sided network: households (demand), suppliers/vendors (stock),
// riders (last-mile + middle-mile logistics — the core engine).
// No blockchain, no crypto. Mobile-money fintech + logistics only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum Role {
  HOUSEHOLD
  SUPPLIER
  RIDER
  ADMIN
  DISTRIBUTOR
  BRAND
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum ProductType {
  REFILL     // gas refill (exchange empty for full)
  CYLINDER   // brand-new full cylinder
  ACCESSORY  // regulator, burner, pipe, grill, hotplate
}

enum OrderStatus {
  PLACED         // household submitted
  ALERTED        // supplier notified
  ACCEPTED       // supplier confirmed stock + payment
  BROADCAST      // (legacy) open to nearby riders
  CLAIMED        // (legacy) a rider took the job
  RIDER_OFFERED  // supplier assigned a specific rider, awaiting accept
  RIDER_ACCEPTED // rider accepted → fee proposed to household
  FEE_CONFIRMED  // household confirmed the rider fee → live tracking
  PICKED         // rider collected from vendor
  DELIVERED      // dropped at household (awaiting confirm/rating)
  COMPLETED      // settled
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  CLAIMED
  PICKED
  DELIVERED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MPESA        // Vodacom M-Pesa TZ
  TIGOPESA     // Mixx by Yas
  AIRTELMONEY
  HALOPESA
  CARD
  CASH
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum WalletTxnType {
  EARNING        // delivery / sale earnings credited to the user
  CASH_FLOAT     // rider collected cash → owes the platform its share (debit)
  PAYOUT         // disbursed to the user (debit)
  SETTLEMENT     // rider/supplier paid the platform what they owed (credit)
  REFERRAL       // referral bonus credit
  LOYALTY        // loyalty redemption
  REFUND         // refund credited
  ADJUSTMENT     // manual admin correction
}

enum RestockStatus {
  REQUESTED
  ACCEPTED
  IN_TRANSIT
  FULFILLED
  CANCELLED
}

enum CylinderStatus {
  WITH_SUPPLIER
  WITH_HOUSEHOLD
  IN_TRANSIT
  RETURN_REQUESTED
  RETURNED
  RETIRED
}

enum RiderStatus {
  OFFLINE
  ONLINE
  ON_JOB
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum VehicleType {
  MOTORBIKE   // boda-boda / pikipiki
  BAJAJI      // three-wheeler
  CAR
  TRUCK
  BICYCLE
}

enum SupplierTier {
  FREE
  STANDARD
  PREMIUM
}

// ── Core ────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  pinHash         String
  role            Role      @default(HOUSEHOLD)
  name            String?
  email           String?
  profilePicUrl   String?

  region          String?   // Dar es Salaam, Mwanza, Arusha, Dodoma, Mbeya, Zanzibar...
  kycStatus       KycStatus @default(PENDING)
  kycName         String?
  kycIdType       String?
  kycIdNumber     String?
  kycSelfieUrl    String?   @db.Text   // KYC selfie (data URL / hosted)
  kycIdUrl        String?   @db.Text   // KYC ID document image

  isActive        Boolean   @default(true)
  isFrozen        Boolean   @default(false)
  isAdmin         Boolean   @default(false)

  // Growth: referrals + loyalty (Tier 3)
  referralCode    String?   @unique
  referredById    String?
  loyaltyPoints   Int       @default(0)

  // Login lockout
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?

  isOnline        Boolean   @default(false)
  lastSeenAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  addresses         Address[]
  supplierProfile   SupplierProfile?
  distributorProfile DistributorProfile?
  brandProfile      BrandProfile?
  riderProfile      RiderProfile?
  orders            Order[]            @relation("HouseholdOrders")
  deliveries        Delivery[]         @relation("RiderDeliveries")
  payouts           Payout[]
  reviews           Review[]           @relation("ReviewAuthor")
  wallet            Wallet?
  cashoutRequests   CashoutRequest[]
  subscriptions     Subscription[]
  referralsMade     Referral[]         @relation("Referrer")
  favorites         Favorite[]

  // Universal marketplace (phase 1) — virtual back-relations, no column changes.
  memberships       Membership[]
  driverLegs        ShipmentLeg[]      @relation("DriverLegs")
}

// ── Favourite vendors (Tier 3 retention) ─────────────────────────────────────────
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  supplierId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  lat       Float
  lng       Float
  street    String?
  ward      String?
  district  String?
  region    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

// ── Supplier / Vendor ────────────────────────────────────────────────────────────

model SupplierProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  businessName  String
  phone         String
  logoUrl       String?
  region        String
  district      String?
  ward          String?
  lat           Float?
  lng           Float?
  isOpen        Boolean      @default(true)
  isVerified    Boolean      @default(false)
  acceptsCash   Boolean      @default(true)
  acceptsMobile Boolean      @default(true)
  tier          SupplierTier @default(FREE)
  featured      Boolean      @default(false)
  rating        Float        @default(0)
  ratingCount   Int          @default(0)
  distributor   String?      // upstream depot/distributor name (middle-mile)

  // Business + mobile-wallet payment details declared at KYC and shown to
  // households when they open the vendor.
  description   String?      @db.Text  // about / landmark / directions
  payProvider   String?      // M-Pesa | Tigo Pesa | Airtel Money | Halopesa
  payNumber     String?      // wallet number / Lipa Namba (till) to receive payment
  payName       String?      // registered name on the wallet

  openHour      Int?         // 0–23: auto-close outside these hours when set
  closeHour     Int?

  createdAt     DateTime     @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory       Inventory[]
  orders          Order[]
  restockRequests RestockRequest[]
  restockOrders   RestockOrder[]

  @@index([region, isOpen])
  @@index([isOpen, lat, lng])   // geo bounding-box vendor search
}

// ── Rider / Logistics ────────────────────────────────────────────────────────────

model RiderProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  vehicleType     VehicleType @default(MOTORBIKE)
  plateNo         String?
  region          String
  status          RiderStatus @default(OFFLINE)
  currentLat      Float?
  currentLng      Float?
  isVerified      Boolean     @default(false)
  rating          Float       @default(0)
  ratingCount     Int         @default(0)
  totalDeliveries Int         @default(0)
  totalEarnings   Float       @default(0)
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([region, status])
}

// ── Catalog ──────────────────────────────────────────────────────────────────────

model Product {
  id        String      @id @default(cuid())
  brand     String      // Taifa Gas, Oryx, Lake Gas, O-Gas, Manjis, Camel Gas
  name      String
  type      ProductType @default(REFILL)
  sizeKg    Float?      // 6, 15, 38, 45  (null for accessory)
  imageUrl  String?
  createdAt DateTime    @default(now())

  inventory  Inventory[]
  orderItems OrderItem[]
  distributorStock DistributorStock[]
  restockItems     RestockItem[]

  // Universal marketplace (phase 1). Offer supersedes Inventory and
  // DistributorStock; all three coexist until phase 8 contracts the old ones.
  offers     Offer[]

  @@index([brand, type])
}

model Inventory {
  id          String  @id @default(cuid())
  supplierId  String
  productId   String
  price       Float   // TZS
  stock       Int     @default(0)
  isAvailable Boolean @default(true)

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

// ── Orders ───────────────────────────────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  orderNo          String      @unique
  householdId      String
  supplierId       String
  addressId        String
  status           OrderStatus @default(PLACED)

  itemsTotal       Float       @default(0)
  deliveryFee      Float       @default(0)   // gross rider fee paid by household
  serviceFee       Float       @default(0)   // platform convenience fee (Phase 1)
  surgeMultiplier  Float       @default(1)
  total            Float       @default(0)
  commissionPct    Float       @default(0)
  commissionAmount Float       @default(0)   // platform cut of itemsTotal
  riderNet         Float       @default(0)   // deliveryFee − platform delivery margin
  platformAmount   Float       @default(0)   // commission + serviceFee + delivery margin

  note             String?
  placedAt         DateTime    @default(now())
  acceptedAt       DateTime?
  deliveredAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  household User            @relation("HouseholdOrders", fields: [householdId], references: [id])
  supplier  SupplierProfile @relation(fields: [supplierId], references: [id])
  address   Address         @relation(fields: [addressId], references: [id])
  items     OrderItem[]
  delivery  Delivery?
  payment   Payment?
  review    Review?
  messages  ChatMessage[]
  disputes  Dispute[]

  @@index([householdId, status])
  @@index([supplierId, status])
  @@index([status, placedAt])
}

// ── In-app chat (order-scoped: household ↔ rider ↔ supplier) ─────────────────────
model ChatMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  readAt    DateTime?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ── Disputes / issue reports (Tier 2 trust) ──────────────────────────────────────
model Dispute {
  id         String        @id @default(cuid())
  orderId    String
  raisedById String
  reason     String
  detail     String?
  status     DisputeStatus @default(OPEN)
  resolution String?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String  // snapshot
  brand       String
  sizeKg      Float?
  qty         Int     @default(1)
  unitPrice   Float
  lineTotal   Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Delivery {
  id             String         @id @default(cuid())
  orderId        String         @unique
  riderId        String?
  status         DeliveryStatus @default(PENDING)
  riderFee       Float          @default(0)

  pickupLat      Float?
  pickupLng      Float?
  dropLat        Float?
  dropLng        Float?
  riderLat       Float?
  riderLng       Float?
  lastLocationAt DateTime?

  otp            String?
  proofPhotoUrl  String?
  claimedAt      DateTime?
  pickedAt       DateTime?
  deliveredAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider User? @relation("RiderDeliveries", fields: [riderId], references: [id])

  @@index([riderId, status])
  @@index([status])
}

// ── Payments / Payouts ───────────────────────────────────────────────────────────

model Payment {
  id          String          @id @default(cuid())
  orderId     String          @unique
  provider    PaymentProvider @default(MPESA)
  amount      Float
  currency    String          @default("TZS")
  status      PaymentStatus   @default(PENDING)
  providerRef String?
  phone       String?
  createdAt   DateTime        @default(now())
  paidAt      DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerRef])
}

model Payout {
  id          String       @id @default(cuid())
  userId      String
  orderId     String?
  role        String       // SUPPLIER | RIDER | PLATFORM
  amount      Float
  status      PayoutStatus @default(PENDING)
  provider    String?
  providerRef String?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

// ── Wallet + ledger (rider/supplier balances + rider cash float) ─────────────────
// balance = net TZS the platform owes the user. NEGATIVE means the user owes the
// platform (e.g. a rider who collected cash-on-delivery owes the platform its cut).
model Wallet {
  id        String      @id @default(cuid())
  userId    String      @unique
  balance   Float       @default(0)
  currency  String      @default("TZS")
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  txns      WalletTxn[]
}

model WalletTxn {
  id           String        @id @default(cuid())
  walletId     String
  type         WalletTxnType
  amount       Float         // signed: + credit to user, − debit
  balanceAfter Float
  orderId      String?
  note         String?
  createdAt    DateTime      @default(now())
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model CashoutRequest {
  id          String       @id @default(cuid())
  userId      String
  amount      Float
  status      PayoutStatus @default(PENDING)
  provider    String?      // mobile wallet network
  phone       String?
  note        String?
  providerRef String?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

// ── Auto-refill subscriptions (Tier 3 retention) ─────────────────────────────────
model Subscription {
  id           String   @id @default(cuid())
  householdId  String
  supplierId   String
  addressId    String
  items        Json     // [{ productId, qty }] — re-resolved to live stock each run
  intervalDays Int      @default(30)
  nextRunAt    DateTime
  isActive     Boolean  @default(true)
  lastOrderId  String?
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  household    User     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
  @@index([householdId])
}

// ── Referrals (Tier 3 growth) ────────────────────────────────────────────────────
model Referral {
  id          String       @id @default(cuid())
  referrerId  String
  refereeId   String       @unique          // one reward per referred user
  status      PayoutStatus @default(PENDING) // PENDING until referee's 1st completed order
  reward      Float        @default(0)
  createdAt   DateTime     @default(now())
  rewardedAt  DateTime?
  referrer    User         @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// ── Supply-chain (middle-mile restock) ──────────────────────────────────────────

model RestockRequest {
  id           String        @id @default(cuid())
  supplierId   String
  productId    String?
  distributor  String?
  qty          Int
  status       RestockStatus @default(REQUESTED)
  note         String?
  riderId      String?
  fee          Float?
  createdAt    DateTime      @default(now())
  fulfilledAt  DateTime?

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, status])
}

// ── Distributors (B2B upstream: depots/dealers that supply gas shops) ────────────
model DistributorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  phone        String?
  region       String?
  district     String?
  lat          Float?
  lng          Float?
  brands       String?                  // comma-separated brands carried (display)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock         DistributorStock[]
  restockOrders RestockOrder[]

  @@index([region, isActive])
}

model DistributorStock {
  id            String   @id @default(cuid())
  distributorId String
  productId     String
  price         Int                      // wholesale price (TZS)
  stock         Int      @default(0)
  isAvailable   Boolean  @default(true)

  distributor DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([distributorId, productId])
  @@index([distributorId])
}

// A gas shop restocking wholesale from a distributor. RECEIVED tops up the shop's
// retail Inventory automatically, closing the upstream supply gap.
model RestockOrder {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  supplierId    String                    // the gas shop (SupplierProfile)
  distributorId String
  status        String   @default("PLACED")  // PLACED ACCEPTED DISPATCHED RECEIVED CANCELLED
  total         Int      @default(0)
  payMethod     String   @default("CREDIT")  // CREDIT CASH MOBILE
  note          String?
  createdAt     DateTime @default(now())
  acceptedAt    DateTime?
  dispatchedAt  DateTime?
  receivedAt    DateTime?

  supplier    SupplierProfile    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  distributor DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  items       RestockItem[]

  @@index([distributorId, status])
  @@index([supplierId, status])
}

model RestockItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  brand     String
  name      String
  qty       Int
  unitPrice Int

  order   RestockOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ── Reviews ──────────────────────────────────────────────────────────────────────

model Review {
  id             String   @id @default(cuid())
  orderId        String   @unique
  authorId       String
  supplierId     String?
  riderId        String?
  supplierRating Int?     // 1..5
  riderRating    Int?     // 1..5
  comment        String?
  createdAt      DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id])
}

// ── Cylinder registry (plain DB, no chain) ──────────────────────────────────────

model Cylinder {
  id         String         @id @default(cuid())
  serial     String?        @unique  // physical serial if known (optional for self-registered)
  brand      String
  sizeKg     Float
  ownerId    String?        // current holder (household / supplier user id)
  status     CylinderStatus @default(WITH_SUPPLIER)
  deposit    Int            @default(0)  // refundable deposit paid for the cylinder shell
  region     String?
  createdAt  DateTime       @default(now())
  returnedAt DateTime?

  @@index([ownerId])
  @@index([status])
}

// ── EWURA price regulation ───────────────────────────────────────────────────────

model PriceCap {
  id        String   @id @default(cuid())
  region    String
  productId String?
  maxPrice  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([region, productId])
}

// ── Brand advertising (Phase 3 monetization) ────────────────────────────────────
// LPG brands (Oryx, Taifa, Lake, O-Gas…) and accessory sellers pay for a
// "Sponsored" slot on the household home. Tapping filters search to that brand.

model BrandAd {
  id        String   @id @default(cuid())
  brand     String                       // links to Product.brand for the filter tap
  title     String                       // headline shown on the banner
  subtitle  String?
  imageUrl  String?  @db.Text            // logo / banner art (data URL or hosted)
  ownerId   String?                       // BRAND user who authored it (null = admin-created)
  ctaLabel  String?                       // e.g. "Order Oryx 15kg"
  linkUrl   String?  @db.Text             // optional external CTA link; else taps filter by brand
  bgColor   String?                       // optional brand hex bg (e.g. #0A7C3A); else brand gradient
  animation String   @default("none")     // banner motion: none|pulse|shine|slide|float|zoom
  region    String?                       // null = nationwide
  type      ProductType?                  // optional: deep-link the search type
  weight    Int      @default(1)          // higher = shown more often
  status    String   @default("PENDING")  // moderation: PENDING | APPROVED | REJECTED
  isActive  Boolean  @default(true)        // advertiser on/off (only matters once APPROVED)
  impressions Int    @default(0)
  clicks    Int      @default(0)
  leads     Int      @default(0)          // "Shop now" details submitted
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  adLeads   AdLead[]

  @@index([isActive, region])
  @@index([ownerId])
}

// A marketer/gas company (Oryx, Taifa…) self-serving ads + leads + demand data.
model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  brandName   String
  contactName String?
  phone       String?
  logoUrl     String?  @db.Text
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A "Shop now" enquiry from a household — the advertiser/distributor follows up.
model AdLead {
  id        String   @id @default(cuid())
  adId      String
  ad        BrandAd  @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  phone     String
  note      String?
  region    String?
  status    String   @default("NEW")      // NEW | CONTACTED | CLOSED
  createdAt DateTime @default(now())

  @@index([adId])
  @@index([status, createdAt])
}

// ── Notifications ────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// UNIVERSAL MARKETPLACE — phase 1 (expand)
//
// Additive only. Nothing reads these yet; the gas flow is untouched and every
// table above keeps its current shape. Back-relations added to User and Product
// are virtual (the foreign keys live on the new tables) so no existing column
// changes. See docs/refactor/UNIVERSAL-MARKETPLACE.md.
//
// Money on new tables is INTEGER MINOR UNITS + an explicit ISO-4217 currency —
// never Float. The legacy Float columns migrate in phase 3.
// ═══════════════════════════════════════════════════════════════════════════════

/// What a trading party is. A party may both buy and sell — a shop buys from a
/// wholesaler and sells to consumers — which a single Role enum cannot express.
enum OrgKind {
  INDIVIDUAL    // a private consumer
  RETAILER      // shop / vendor (today's SupplierProfile)
  WHOLESALER    // distributor / depot (today's DistributorProfile)
  MANUFACTURER  // producer at the top of the chain
  CARRIER       // transport company / owner-driver
  PLATFORM      // the operator itself
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF
  DRIVER
}

/// The trading entity. Orders link org→org, so consumers get an auto-created
/// INDIVIDUAL org and the order code needs no special case for private buyers.
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  kind        OrgKind  @default(INDIVIDUAL)

  // Capabilities rather than a role: set independently of kind so an unusual
  // party (a manufacturer that also runs its own trucks) is representable.
  canBuy      Boolean  @default(true)
  canSell     Boolean  @default(false)
  canCarry    Boolean  @default(false)

  // Market configuration — this is what replaces tenancy. One marketplace,
  // many markets.
  countryCode String   @default("TZ")   // ISO-3166-1 alpha-2
  currency    String   @default("TZS")  // ISO-4217
  locale      String   @default("en")
  timezone    String   @default("Africa/Dar_es_Salaam")

  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  rating      Float    @default(0)
  ratingCount Int      @default(0)

  // Storefront (see §4) — a seller is a browsable shop, not just a map pin.
  logoUrl     String?  @db.Text
  description String?  @db.Text
  lat         Float?
  lng         Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships        Membership[]
  offers             Offer[]
  shipmentsAsShipper Shipment[]   @relation("ShipperOrg")
  shipmentsAsCarrier Shipment[]   @relation("CarrierOrg")

  @@index([kind, isActive])
  @@index([countryCode, kind])
  @@index([canSell, isActive])
}

/// Which humans may act for which organization. Replaces User.role for
/// authorization; User.role survives only as a default UI hint.
model Membership {
  id        String     @id @default(cuid())
  userId    String
  orgId     String
  role      MemberRole @default(OWNER)
  createdAt DateTime   @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId],  references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Product taxonomy. `attributeSchema` is a JSON-Schema describing the fields a
/// product in this category carries, so a new vertical (water, agro, pharmacy)
/// is configuration rather than a migration.
model Category {
  id              String   @id @default(cuid())
  parentId        String?
  key             String   @unique   // "lpg_refill", "cement_50kg"
  name            String
  unitType        String   @default("piece") // piece | kg | litre | m3 | pack
  attributeSchema Json     @default("{}")
  imageUrl        String?  @db.Text
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  @@index([parentId, isActive])
}

/// Who sells a product, at what price. Replaces Inventory (retail) and
/// DistributorStock (wholesale) — the same relation at different tiers.
///
/// Splitting Offer from Product is what lets one product page list many
/// competing sellers, which is the core marketplace dynamic (§4).
model Offer {
  id          String   @id @default(cuid())
  productId   String
  sellerOrgId String

  priceMinor  Int                        // integer minor units, never Float
  currency    String   @default("TZS")
  stock       Int      @default(0)
  moq         Int      @default(1)       // minimum order qty — wholesale tiers
  isAvailable Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product      @relation(fields: [productId],   references: [id], onDelete: Cascade)
  seller  Organization @relation(fields: [sellerOrgId], references: [id], onDelete: Cascade)

  @@unique([sellerOrgId, productId])
  @@index([productId, isAvailable])
  @@index([sellerOrgId, isAvailable])
}

enum ShipmentStatus {
  DRAFT
  PLANNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum LegStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  FAILED
}

/// A physical movement of goods. `orderId` is nullable because a freight job
/// from the load board has no product order behind it.
model Shipment {
  id           String         @id @default(cuid())
  orderId      String?                    // FK added in phase 4, when Order moves
  shipperOrgId String
  carrierOrgId String?
  status       ShipmentStatus @default(DRAFT)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  shipper Organization  @relation("ShipperOrg", fields: [shipperOrgId], references: [id])
  carrier Organization? @relation("CarrierOrg", fields: [carrierOrgId], references: [id])
  legs    ShipmentLeg[]

  @@index([shipperOrgId, status])
  @@index([carrierOrgId, status])
  @@index([orderId])
}

/// One hop. A consumer delivery is a single leg; a full chain
/// (manufacturer→wholesaler→shop→consumer) is several, which is what the map
/// renders end to end (§7).
model ShipmentLeg {
  id           String    @id @default(cuid())
  shipmentId   String
  seq          Int                        // 0,1,2… order along the chain

  originLat    Float
  originLng    Float
  destLat      Float
  destLng      Float
  originLabel  String?
  destLabel    String?

  vehicleId    String?                    // FK added with Vehicle in phase 6
  driverUserId String?
  status       LegStatus @default(PENDING)

  /// Encoded polyline from the routing provider, computed server-side ONCE per
  /// leg. Today the browser re-fetches a route every time the rider moves.
  plannedRoute String?   @db.Text
  distanceM    Int?
  durationS    Int?

  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  shipment Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver   User?          @relation("DriverLegs", fields: [driverUserId], references: [id])
  pings    TrackingPing[]

  @@unique([shipmentId, seq])
  @@index([driverUserId, status])
  @@index([status])
}

/// Location history for a leg. Written throttled (the socket layer already rate
/// limits writes); the live relay stays in-memory.
model TrackingPing {
  id      String   @id @default(cuid())
  legId   String
  lat     Float
  lng     Float
  speed   Float?
  heading Float?
  at      DateTime @default(now())

  leg ShipmentLeg @relation(fields: [legId], references: [id], onDelete: Cascade)

  @@index([legId, at])
}
